ALGOD_SERVER=http://localhost
ALGOD_PORT=4001
ALGOD_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

INDEXER_SERVER=http://localhost
INDEXER_PORT=8980
INDEXER_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

appBiatecIdentityProvider=
appBiatecPoolProvider=
appBiatecConfigProvider=

signer1=
signer2=
signer3=
signer4=
signer5=

msigThreshold=
deployerAddr=

governor=
engagement=
verifier=

# Base URL of the Biatec Trade Reporter API (AVM Trade Reporter), used by clamm-pool-withdraw-biatec-fees-to-all-pools.sh
# to value collected fees in USD. e.g. https://api.algorand.scan.biatec.io (mainnet) or https://api.testnet.scan.biatec.io (testnet)
BIATEC_TRADE_REPORTER_API=https://api.algorand.scan.biatec.io
# Optional: minimum USD valuation of a pool's collected biatec fees required to withdraw them (default 1)
minWithdrawUsd=1
# Optional: set to true to preview withdrawals/swaps/liquidity-add without sending any transaction
dryRun=true

# Base URL of the Biatec Router API, used by clamm-pool-withdraw-biatec-fees-to-all-pools.sh to swap withdrawn
# fee assets into VOTE/GOLD. e.g. https://router.api.biatec.io (mainnet) or https://testnet.router.api.biatec.io (testnet)
BIATEC_ROUTER_API=https://router.api.biatec.io
# Asset ids kept unswapped by clamm-pool-withdraw-biatec-fees-to-all-pools.sh - every other withdrawn asset is
# routed half into VOTE, half into GOLD, then added as liquidity to the narrowest VOTE/GOLD pool
voteAssetId=452399768
goldAssetId=1241944285
# Optional: slippage tolerance in basis points applied to router quotes (100 = 1%, default 100)
routerSlippageBps=10
# Optional: comma-separated extra asset ids to exclude from swapping (e.g. to keep some ALGO for MBR/fees, or to
# leave a specific asset alone). The native asset (id 0) is always excluded, even if not listed here.
excludeSwapAssetIds=0
